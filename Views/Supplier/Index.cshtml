@using InventoryManagementSystem.Models.Supplier;
@model IEnumerable<Supplier>
<h2 class="my-6">Suppliers</h2>
<a asp-action="Create" class="btn btn-primary my-4">Add New Supplier</a>
<table class="table border table-striped text-center">
    <tr class="text-center">
        <th>Id</th>
        <th>Name</th>
        <th>Address</th>
        <th>Email</th>
        <th>Action</th>
    </tr>
    @foreach(var supplier in Model){
        <tr class="text-center">
            <td>@supplier.Id</td>
            <td>@supplier.Name</td>
            <td>@supplier.Address</td>
            <td>@supplier.Email</td>
            <td>
                <a asp-action="Edit" class="btn btn-secondary" asp-route-id="@supplier.Id">Edit</a>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                        data-bs-target="#deleteModal-@supplier.Id">
                    Delete
                </button>

                <partial name="Delete" model="supplier" />
            </td>
        </tr>

    }

</table>