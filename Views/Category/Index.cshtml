@using InventoryManagementSystem.Models.Category;
@model IEnumerable<Category>
<h2 class="my-6">Categories</h2>
<a asp-action="Create" class="btn btn-primary my-4">Add New Category</a>
<table class="table border table-striped text-center">
    <tr class="text-center">
        <th>Id</th>
        <th>Name</th>
        <th>Action</th>
    </tr>
    @foreach(var category in Model){
        <tr class="text-center">
            <td>@category.Id</td>
            <td>@category.Name</td>
            <td>
                <a asp-action="Edit" class="btn btn-secondary" asp-route-id="@category.Id">Edit</a>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                        data-bs-target="#deleteModal-@category.Id">
                    Delete
                </button>

                <partial name="Delete" model="category" />
            </td>
        </tr>

    }

</table>